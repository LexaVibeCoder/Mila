# ============================================================
# Mila Bot — Environment Configuration
# ============================================================
# Copy this file to .env then edit it with your settings

# --- Telegram ---
# Get these from https://my.telegram.org/apps

API_ID=
API_HASH=
PHONE_NUMBER=

# --- TDLib (pytdbot) ---
# TD_FILES_DIRECTORY=
# TD_DATABASE_ENCRYPTION_KEY=

# --- LLM API (Main brain) ---
# Example for LM Studio: http://172.17.0.1:1234 (docker) or http://127.0.0.1:1234
# Example for OpenRouter: https://openrouter.ai/api/v1

LLM_API_BASE=
LLM_API_KEY=
MAIN_LLM_MODEL=

# --- Embeddings API ---
# Supports LM Studio, Ollama, OpenRouter — any OpenAI-compatible API.

# Ollama (native API auto-detected on port 11434):
#   EMBED_API_BASE=http://172.17.0.1:11434 (docker) or http://127.0.0.1:11434
#   EMBED_MODEL=...

# LM Studio:
#   EMBED_API_BASE=http://172.17.0.1:1234 (docker) or http://127.0.0.1:1234

# OpenRouter:
#   EMBED_API_BASE=https://openrouter.ai/api/v1

# --- Embeddings API ---

EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=

# --- Optional: Night LLM (sleep mode) ---

NIGHT_LLM_API_BASE=
NIGHT_LLM_API_KEY=
NIGHT_LLM_MODEL=
NIGHT_LLM_SLEEP_PROMPT=

# --- Optional: Observatory ---
# If OBSERVATORY_PASSWORD is empty, the panel listens on 127.0.0.1 only.
# Set a password to allow remote access (HTTP Basic Auth is then required).

# OBSERVATORY_PORT=8080
# OBSERVATORY_PASSWORD=
# OBSERVATORY_USERNAME=admin
# OBSERVATORY_HOST=

# --- Presence: auto-exit dialog → rest after silence ---
# DIALOG_IDLE_TIMEOUT_SECONDS=300
# DIALOG_IDLE_CHECK_INTERVAL_SECONDS=30

# --- TDLib ---
# Set a unique random value on first install. Changing it later makes the
# existing data/tdlib unreadable — change only together with a fresh data dir.
# Leave empty to disable TDLib database encryption (fresh data dir only;
# start/install.sh asks about this during the first login).
# TD_DATABASE_ENCRYPTION_KEY=

# --- Local timezone for message metadata (date/time added to each message
#     sent to the LLM context). IANA name, e.g. "Europe/Moscow".
#     Empty = use the system's local zone (honors TZ env / mounted /etc/localtime),
#     so it works out of the box both on the host and in Docker (with tzdata installed). ---

# LOCAL_TIMEZONE=Europe/Moscow