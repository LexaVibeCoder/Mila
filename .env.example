# ============================================================
# Mila Bot — Environment Configuration
# ============================================================
# Copy this file to .env then edit it with your settings

# --- Telegram ---
# Get these from https://my.telegram.org/apps

API_ID=
API_HASH=
PHONE_NUMBER=

# --- TDLib (pytdbot) ---
# TD_FILES_DIRECTORY=
# Set a unique random key on first install. Changing it later makes the
# existing session unreadable. Leave empty to disable encryption for a fresh
# session. start/install.sh asks about this during the first login.
# TD_DATABASE_ENCRYPTION_KEY=

# --- LLM API (Main brain) ---
# Example for LM Studio: http://172.17.0.1:1234 (docker) or http://127.0.0.1:1234
# Example for OpenRouter: https://openrouter.ai/api/v1

LLM_API_BASE=
LLM_API_KEY=
MAIN_LLM_MODEL=

# --- Optional: Decision model (OpenRouter Decisions API) ---
# Use the Decisions API base URL without the final /decisions.
# Set DECISION_MODEL to a decision model ID, e.g. typesafe/jev-1.14.
# Set both the key and the model to enable decision requests.
DECISION_API_BASE=https://openrouter.ai/api/alpha
DECISION_API_KEY=
DECISION_MODEL=

# --- Embeddings API ---
# Supports LM Studio, Ollama, OpenRouter — any OpenAI-compatible API.

# Ollama (native API auto-detected on port 11434):
#   EMBED_API_BASE=http://172.17.0.1:11434 (docker) or http://127.0.0.1:11434
#   EMBED_MODEL=...

# LM Studio:
#   EMBED_API_BASE=http://172.17.0.1:1234 (docker) or http://127.0.0.1:1234

# OpenRouter:
#   EMBED_API_BASE=https://openrouter.ai/api/v1

EMBED_API_BASE=
EMBED_API_KEY=
EMBED_MODEL=
# Must match the embedding model dimension.
# nomic-embed-text = 384, text-embedding-3-small = 1536, etc.
EMBED_DIM=384

# --- Optional: Night LLM (sleep mode) ---
# Optional separate API key. Empty uses LLM_API_KEY.
# Set the night model and base URL in Observatory.
NIGHT_LLM_API_KEY=

# --- Optional: Observatory ---
# Docker (docker-compose.yml):
#   OBSERVATORY_PORT          published port, same inside and outside the container.
#   OBSERVATORY_PUBLISH_HOST  host interface for the published port:
#                             127.0.0.1 = local only (default),
#                             0.0.0.0   = all interfaces (set a password!).
#   OBSERVATORY_BIND_HOST     address the panel binds inside the container
#                             (default 0.0.0.0; change only if you know why).
# Non-Docker (`python -m Mila_observatory.server`):
#   OBSERVATORY_HOST          bind address (default 127.0.0.1).
# In Docker, OBSERVATORY_HOST is overridden by OBSERVATORY_BIND_HOST.

# OBSERVATORY_PORT=8080
# OBSERVATORY_PUBLISH_HOST=127.0.0.1
# OBSERVATORY_BIND_HOST=0.0.0.0
# OBSERVATORY_HOST=127.0.0.1
# OBSERVATORY_PASSWORD=
# OBSERVATORY_USERNAME=admin

# --- Presence: auto-exit dialog → rest after silence ---
# DIALOG_IDLE_TIMEOUT_SECONDS=300
# DIALOG_IDLE_CHECK_INTERVAL_SECONDS=30

# --- Local timezone for message metadata and diary reports ---
# IANA name. Empty uses the system timezone (TZ or /etc/localtime).
# LOCAL_TIMEZONE=Europe/Moscow

# --- Optional: E2E test bot (test_tg_bot_dialogue.py) ---
# Token from @BotFather. Before running the test, send /start to this bot
# from Mila's own Telegram account (Telegram forbids bots to write first).
# TEST_BOT_TOKEN=
# Numeric ID of Mila's account. Optional — if the bot has exactly one chat,
# the script selects it automatically.
# MILA_TEST_TARGET_ID=
